def create_stat(parent, label, color):

    frame = tk.Frame(
        parent,
        bg=PANEL,
        padx=15,
        pady=15
    )

    tk.Label(
        frame,
        text=label,
        bg=PANEL,
        fg=MUTED,
        font=("Arial", 9, "bold")
    ).pack(anchor="w")

    value = tk.Label(
        frame,
        text="0",
        bg=PANEL,
        fg=color,
        font=("Arial", 25, "bold")
    )

    value.pack(anchor="w")

    return frame, value


