
import tkinter as tk
import pydirectinput
import keyboard
import random

# ==========================================
# CONFIGURATION
# ==========================================

pydirectinput.PAUSE = 0
pydirectinput.FAILSAFE = True

running = False
mouse_count = 0
key_count = 0

job = None
release_job = None
active_key = None

mouse_held = False
key_held = False

BG = "#090B12"
PANEL = "#151827"
PANEL2 = "#20243A"
PURPLE = "#A78BFA"
CYAN = "#67E8F9"
WHITE = "#F1F2F8"
MUTED = "#858AA3"
GREEN = "#34D399"
RED = "#FB7185"

KEYS = list("abcdefghijklmnopqrstuvwxyz0123456789")

# ==========================================
# GESTION DES ENTREES
# ==========================================

def release_inputs():
    global active_key, mouse_held, key_held

    try:
        if key_held and active_key:
            pydirectinput.keyUp(active_key)

        if mouse_held:
            pydirectinput.mouseUp(button="left")

    except Exception as error:
        print("Erreur release:", error)

    active_key = None
    mouse_held = False
    key_held = False


def start():
    global running

    if running:
        return

    running = True

    status_label.config(
        text="● RUNNING",
        fg=GREEN
    )

    start_button.config(text="PAUSE")

    automation()


def stop():
    global running, job, release_job

    running = False

    if job is not None:
        root.after_cancel(job)
        job = None

    if release_job is not None:
        root.after_cancel(release_job)
        release_job = None

    release_inputs()

    status_label.config(
        text="● STOPPED",
        fg=RED
    )

    start_button.config(text="START")


def toggle():
    if running:
        stop()
    else:
        start()




# ==========================================
# AUTOMATISATION
# ==========================================

def automation():
    global mouse_count, key_count
    global job, release_job
    global active_key, mouse_held, key_held

    if not running:
        return

    mode = mode_var.get()

    try:

        if mode in ("Clavier", "Combiné"):

            active_key = random.choice(KEYS)

            pydirectinput.keyDown(active_key)
            key_held = True

            key_count += 1

        if mode in ("Souris", "Combiné"):

            pydirectinput.mouseDown(button="left")
            mouse_held = True

            mouse_count += 1

        update_counters()

        def release():
            global release_job
            release_inputs()
            release_job = None

        release_job = root.after(50, release)

        delay = max(100, int(1000 / cps.get()))

        job = root.after(delay, automation)

    except Exception as error:

        stop()

        status_label.config(
            text="● ERROR",
            fg=RED
        )

        print(error)


# ==========================================
# COMPTEURS
# ==========================================

def update_counters():

    mouse_value.config(text=str(mouse_count))
    key_value.config(text=str(key_count))


def reset():

    global mouse_count, key_count

    mouse_count = 0
    key_count = 0

    update_counters()


# ==========================================
# RACCOURCIS CLAVIER
# ==========================================

def register_shortcuts():

    keyboard.add_hotkey(
        "F6",
        lambda: root.after(0, toggle)
    )

    keyboard.add_hotkey(
        "F7",
        lambda: root.after(0, stop)
    )

    keyboard.add_hotkey(
        "F10",
        lambda: root.after(0, close_app)
    )


